# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AI Powered Port Management System
APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false
ENABLE_DOCS=true
REQUEST_ID_HEADER=X-Request-ID
MAX_REQUEST_BODY_MB=50
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# -----------------------------------------------------------------------------
# Security and cryptography
# -----------------------------------------------------------------------------
APP_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
PASSWORD_PEPPER=
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SECURITY_HEADERS_ENABLED=true
AUDIT_LOG_ENABLED=true
PII_LOG_REDACTION_ENABLED=true
PROMPT_INJECTION_FILTER_ENABLED=true
FILE_HASH_ALGORITHM=sha256
UPLOAD_MIME_ALLOWLIST=application/pdf,text/csv,application/json,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
UPLOAD_EXTENSION_ALLOWLIST=.pdf,.csv,.json,.xlsx
UPLOAD_MAX_MB=200
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/postgres
DB_SSL_MODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=60
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
SOURCE_SCHEMA=public
EXTRACT_SCHEMA=pms_extract_2010_2023
APP_SCHEMA=pms_app
DOCUMENT_SCHEMA=pms_doc
VECTOR_SCHEMA=pms_vector
RULE_SCHEMA=pms_rules
FORECAST_SCHEMA=pms_forecast
GRAPH_SCHEMA=pms_graph
AUDIT_SCHEMA=pms_audit
RLS_ENABLED=true
DB_READONLY_ROLE=pms_readonly
DB_APPLICATION_ROLE=pms_app_role
DB_MIGRATION_ROLE=pms_migration_role

# -----------------------------------------------------------------------------
# Effective-dated rule engine
# -----------------------------------------------------------------------------
RULE_CALCULATION_VERSION=1.0
RULE_ROUNDING_METHOD=ROUND_HALF_UP
RULE_MONEY_SCALE=2
RULE_MAX_SEGMENTS=500
RULE_CANDIDATE_BATCH_SIZE=500
RULE_REQUIRE_DUAL_APPROVAL=true
RULE_REQUIRE_DOCUMENT_EVIDENCE=true

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_ENABLED=true
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=pms
KEYCLOAK_CLIENT_ID=pms-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/pms
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/pms/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=pms-api
KEYCLOAK_VERIFY_SSL=false
PMS_DEMO_MODE=false
PMS_DEMO_DATABASE_URL=
PMS_DEMO_DATABASE_ROLE=pms_demo_runtime
PMS_DEMO_MAX_ROWS=10
PMS_DEMO_STATEMENT_TIMEOUT_SECONDS=5
# Disabled-by-default localhost password login for the four-role client demo.
# Store scrypt hashes, never plaintext passwords. Generate each hash with:
# .\.venv\Scripts\python.exe .\scripts\create_local_auth_hash.py
LOCAL_PASSWORD_AUTH_ENABLED=false
LOCAL_AUTH_TOKEN_TTL_MINUTES=60
LOCAL_AUTH_DATA_ENTRY_OPERATOR_USERNAME=
LOCAL_AUTH_DATA_ENTRY_OPERATOR_PASSWORD_HASH=
LOCAL_AUTH_NODAL_REGIONAL_OFFICER_USERNAME=
LOCAL_AUTH_NODAL_REGIONAL_OFFICER_PASSWORD_HASH=
LOCAL_AUTH_HOD_USERNAME=
LOCAL_AUTH_HOD_PASSWORD_HASH=
LOCAL_AUTH_TENANT_USERNAME=
LOCAL_AUTH_TENANT_PASSWORD_HASH=
LOCAL_AUTH_TENANT_ID=
JWT_ALGORITHM=RS256
JWT_CLOCK_SKEW_SECONDS=60
JWT_TENANT_CLAIM=tenant_id
JWT_ROLE_CLAIM=realm_access.roles
JWT_DEPARTMENT_CLAIM=department
JWT_CLASSIFICATION_CLAIM=classification
AUTHZ_DEFAULT_DENY=true
TENANT_SCOPE_REQUIRED=true

# -----------------------------------------------------------------------------
# MinIO / object storage
# -----------------------------------------------------------------------------
MINIO_ENABLED=true
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_URL=http://127.0.0.1:9001
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_RAW=pms-raw-documents
MINIO_BUCKET_CANONICAL=pms-canonical-documents
MINIO_BUCKET_DERIVED=pms-derived-artifacts
MINIO_BUCKET_MODELS=pms-model-artifacts
MINIO_BUCKET_EVALUATION=pms-evaluation-artifacts
MINIO_OBJECT_LOCK_ENABLED=false
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=300

# -----------------------------------------------------------------------------
# PDF parsing and OCR
# -----------------------------------------------------------------------------
PDF_PRIMARY_PARSER=opendataloader
PDF_PRIMARY_MODE=deterministic
PDF_OUTPUT_FORMATS=json,markdown
PDF_USE_STRUCT_TREE=true
PDF_IMAGE_OUTPUT=external
PDF_THREADS=1
JAVA_HOME=
JAVA_MIN_MAJOR_VERSION=17
OPENDATALOADER_ENABLED=true
OPENDATALOADER_SANITIZE=false
OPENDATALOADER_CONTENT_SAFETY=true
OPENDATALOADER_HYBRID_ENABLED=true
OPENDATALOADER_HYBRID_BACKEND=docling-fast
DOCLING_ENABLED=true
PADDLEOCR_ENABLED=true
PYMUPDF_ENABLED=true
PDFPLUMBER_ENABLED=true
OCR_ENABLED=true
OCR_LANGUAGES=eng,hin,mar
OCR_RENDER_DPI=300
OCR_CONFIDENCE_REVIEW_THRESHOLD=0.90
PDF_QUALITY_GATE_ENABLED=true
PDF_MAX_UNEXPECTED_BLANK_PAGE_RATIO=0.02
PDF_NUMERIC_TOKEN_EXACT_MATCH_REQUIRED=true
PDF_CITATION_BBOX_REQUIRED=true
PDF_HUMAN_REVIEW_ON_CRITICAL_FAILURE=true
PDF_BATCH_SIZE=5
PDF_MAX_RETRIES=2
PDF_PARSE_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# Canonical document and chunking
# -----------------------------------------------------------------------------
CANONICAL_SCHEMA_VERSION=1.0
CHUNK_STRATEGY=structure_aware_parent_child
CHUNK_TARGET_TOKENS=420
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
PARENT_CHUNK_MAX_TOKENS=1600
PRESERVE_TABLE_HEADERS=true
PRESERVE_LEGAL_PROVISOS=true
PRESERVE_FORMULA_CONTEXT=true
CHUNK_HASH_ALGORITHM=sha256
REEMBED_CHANGED_ONLY=true
LANGUAGE_DETECTION_LEVEL=block
DEFAULT_DOCUMENT_CLASSIFICATION=internal

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=flagembedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_SEQUENCE_LENGTH=1024
EMBEDDING_WORKERS=1
EMBEDDING_TIMEOUT_SECONDS=300
EMBEDDING_CACHE_DIR=artifacts/model_cache/embeddings
EMBEDDING_STORE_TEXT=true
EMBEDDING_FAIL_FAST=false
EMBEDDING_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Vector and lexical retrieval
# -----------------------------------------------------------------------------
VECTOR_BACKEND=pgvector
VECTOR_DISTANCE=cosine
VECTOR_INDEX_MODE=exact
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=80
HNSW_ENABLE_AFTER_CHUNK_COUNT=100000
LEXICAL_BACKEND=postgres_fts
LEXICAL_LANGUAGE_CONFIG=simple
LEXICAL_TOP_K=30
DENSE_TOP_K=30
RRF_K=60
RERANK_INPUT_TOP_K=30
RERANK_OUTPUT_TOP_K=8
FINAL_CONTEXT_MAX_CHUNKS=8
FINAL_CONTEXT_MAX_TOKENS=5000
RETRIEVAL_MIN_SCORE=
TEMPORAL_FILTER_REQUIRED=true
DOCUMENT_ACL_FILTER_REQUIRED=true
CITATION_REQUIRED=true
PARENT_EXPANSION_ENABLED=true

# -----------------------------------------------------------------------------
# Reranker
# -----------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_PROVIDER=flagembedding
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=2
RERANKER_MAX_SEQUENCE_LENGTH=1024
RERANKER_CACHE_DIR=artifacts/model_cache/reranker
RERANKER_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Local LLM
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_PRIMARY_MODEL=qwen3.5:4b
LLM_FALLBACK_MODEL=qwen3.5:9b
LLM_ALLOW_FALLBACK=true
LLM_THINKING_ENABLED=false
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_OUTPUT_TOKENS=700
LLM_CONTEXT_WINDOW=8192
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_KEEP_ALIVE=30m
LLM_STREAMING=true
LLM_JSON_MODE_ENABLED=true
LLM_CITATION_VALIDATION_ENABLED=true
LLM_REFUSE_WITHOUT_EVIDENCE=true


# -----------------------------------------------------------------------------
# Shared case chat and context engineering
# -----------------------------------------------------------------------------
CHAT_SCHEMA=pms_chat
CASE_WORKFLOW_ENABLED=true
CASE_THREAD_MODE=shared_case_thread
CASE_DEFAULT_VISIBILITY=case_participants
CASE_REQUIRE_ASSIGNMENT=true
CASE_ALLOW_SILENT_MESSAGE_EDIT=false
CASE_CONTEXT_CAPSULE_ENABLED=true
CASE_CONTEXT_CAPSULE_ON_TRANSITION=true
CASE_RECENT_MESSAGE_WINDOW=12
CASE_RETRIEVED_MESSAGE_TOP_K=8
CASE_CONTEXT_MAX_TOKENS=4500
CASE_SUMMARY_MAX_TOKENS=900
CASE_DECISION_LEDGER_ENABLED=true
CASE_OPEN_TASK_LEDGER_ENABLED=true
CASE_ARTIFACT_VERSIONING_ENABLED=true
CASE_HANDOFF_REQUIRE_REMARKS=true
CASE_NO_SELF_VERIFICATION=true
CASE_NO_SELF_APPROVAL=true
CASE_SLA_ENABLED=true
CASE_STATE_HASH_ALGORITHM=sha256

# -----------------------------------------------------------------------------
# Semantic catalog and constrained Text-to-SQL
# -----------------------------------------------------------------------------
SEMANTIC_CATALOG_ENABLED=true
SEMANTIC_CATALOG_SCHEMA=pms_catalog
SEMANTIC_CATALOG_EMBED_METADATA=true
SEMANTIC_CATALOG_TOP_K_TABLES=8
SEMANTIC_CATALOG_TOP_K_COLUMNS=30
GOVERNED_VIEWS_ONLY=true
TEXT_TO_SQL_ENABLED=true
TEXT_TO_SQL_MODE=templates_first
TEXT_TO_SQL_SELECT_ONLY=true
TEXT_TO_SQL_AST_VALIDATION=true
TEXT_TO_SQL_EXPLAIN_BEFORE_EXECUTE=true
TEXT_TO_SQL_MAX_TABLES=8
TEXT_TO_SQL_MAX_COLUMNS=40
TEXT_TO_SQL_MAX_JOINS=8
TEXT_TO_SQL_MAX_ROWS=500
TEXT_TO_SQL_TIMEOUT_SECONDS=15
TEXT_TO_SQL_MAX_PLAN_COST=100000
TEXT_TO_SQL_ALLOWLIST_SCHEMAS=pms_app,pms_extract_2010_2023,pms_forecast,pms_graph
TEXT_TO_SQL_DENY_SENSITIVE_COLUMNS=true
TEXT_TO_SQL_HUMAN_REVIEW_FOR_HIGH_RISK=true

# -----------------------------------------------------------------------------
# Query routing
# -----------------------------------------------------------------------------
QUERY_ROUTER_MODE=deterministic_first
QUERY_ROUTER_CONFIG=config/query_router.yml
DOMAIN_SYNONYMS_CONFIG=config/domain_synonyms.yml
NL_TO_SQL_ENABLED=false
APPROVED_SQL_ONLY=true
SQL_TEMPLATE_DIR=sql/approved_queries
SQL_MAX_ROWS=500
SQL_STATEMENT_TIMEOUT_SECONDS=15
SQL_ALLOWLIST_SCHEMAS=pms_extract_2010_2023,pms_app,pms_rules,pms_forecast,pms_graph
SQL_DENYLIST_KEYWORDS=DROP,TRUNCATE,ALTER,GRANT,REVOKE,COPY,PROGRAM
AMBIGUITY_CHECK_ENABLED=true
QUERY_MAX_LENGTH=4000

# -----------------------------------------------------------------------------
# Rule engine
# -----------------------------------------------------------------------------
RULE_ENGINE_ENABLED=true
RULE_CURRENCY=INR
RULE_DECIMAL_PRECISION=28
RULE_ROUNDING_MODE=ROUND_HALF_UP
RULE_APPROVAL_REQUIRED=true
RULE_EFFECTIVE_DATE_REQUIRED=true
RULE_SOURCE_CITATION_REQUIRED=true
RULE_PREVENT_OVERLAPPING_APPROVED_PERIODS=true
RULE_RECALCULATION_MODE=dual
RULE_MAX_CALCULATION_SEGMENTS=500
RULE_CALCULATION_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Forecasting and ML
# -----------------------------------------------------------------------------
FORECASTING_ENABLED=true
MODEL_REGISTRY_BACKEND=postgres
MODEL_ARTIFACT_BACKEND=minio
MODEL_RANDOM_SEED=42
MODEL_TRAIN_START_DATE=2010-01-01
MODEL_TRAIN_END_DATE=2023-12-31
FORECAST_FEATURE_VERSION=1.0
FORECAST_SOURCE_TABLE=cash_revenue_data
FORECAST_DEFAULT_CUTOFF=2024-01-01T00:00:00+00:00
FORECAST_DEFAULT_HORIZON_MONTHS=12
FORECAST_CONFIDENCE_LEVEL=0.95
FORECAST_BACKTEST_FOLDS=5
FORECAST_MIN_TRAIN_PERIODS=36
FORECAST_BACKTEST_STEP_MONTHS=12
FORECAST_SEASON_LENGTH=12
FORECAST_REQUIRE_BASELINE_BEAT=true
FORECAST_MAX_TRAINING_MINUTES=60
PREDICTION_DEFAULT_TTL_HOURS=24
PREDICTION_REGENERATE_ON_MODEL_CHANGE=true
PREDICTION_REGENERATE_ON_FEATURE_CHANGE=true
PREDICTION_STORE_ON_DEMAND_RESULTS=true
PREDICTION_HUMAN_REVIEW_REQUIRED=false
REVENUE_TARGET=monthly_cash_collection
LAND_VALUE_TARGET=fair_market_value_per_sq_m
PAYMENT_LATE_THRESHOLD_DAYS=0
COLLECTION_WINDOWS_DAYS=30,60,90

# -----------------------------------------------------------------------------
# Graph
# -----------------------------------------------------------------------------
GRAPH_ENABLED=true
GRAPH_BACKEND=postgres
GRAPH_VERIFIED_EDGES_ONLY=true
GRAPH_LLM_EDGE_AUTOPUBLISH=false
GRAPH_MAX_HOPS=6
GRAPH_MAX_RESULTS=200
GRAPH_REQUIRE_SOURCE_EVIDENCE=true
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_INCLUDE_ACL_IN_KEY=true
CACHE_INCLUDE_SOURCE_VERSION_IN_KEY=true
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------
JOB_BACKEND=postgres
JOB_POLL_SECONDS=5
JOB_MAX_RETRIES=2
JOB_RETRY_BASE_SECONDS=5
JOB_TIMEOUT_SECONDS=1800
JOB_DEAD_LETTER_ENABLED=true
JOB_WORKER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SAMPLE_RATE=0.0
SLOW_QUERY_THRESHOLD_MS=1000
LOG_SQL_PARAMETERS=false
LOG_RETRIEVED_TEXT=false
LOG_MODEL_PROMPTS=false
HEALTHCHECK_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Evaluation and quality gates
# -----------------------------------------------------------------------------
EVALUATION_GOLDEN_SET_DIR=tests/fixtures/golden
RAG_EVALUATION_ENABLED=true
RAG_MIN_CITATION_PRECISION=0.95
RAG_MIN_ANSWER_GROUNDEDNESS=0.90
SQL_EXPECTED_EXACT_ACCURACY=1.00
RULE_EXPECTED_GOLD_CASE_ACCURACY=1.00
FORECAST_MAX_ALLOWED_BIAS=
PERFORMANCE_BENCHMARK_ENABLED=true
PERFORMANCE_WARMUP_REQUESTS=3
PERFORMANCE_TEST_REQUESTS=20

# -----------------------------------------------------------------------------
# Streamlit UI
# -----------------------------------------------------------------------------
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
STREAMLIT_API_URL=http://127.0.0.1:8000/api/v1
STREAMLIT_SHOW_ADMIN=false
